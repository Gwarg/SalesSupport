<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SalesSupport.Core\SalesSupport.Core.csproj" />
    <ProjectReference Include="..\SalesSupport.Capture\SalesSupport.Capture.csproj" />
    <ProjectReference Include="..\SalesSupport.Transcription.Azure\SalesSupport.Transcription.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme faces shipped with the app (D35): Space Grotesk and IBM Plex Mono, both SIL OFL; licenses sit beside them. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
