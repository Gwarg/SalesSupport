<Window x:Class="SalesSupport.Client.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesSupport.Client"
        Title="Transkript" Width="380" Height="560" MinWidth="280" MinHeight="240"
        Topmost="True" Background="#FAF9F5" WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#185FA5"/>
        <SolidColorBrush x:Key="Muted" Color="#6B6A66"/>
        <SolidColorBrush x:Key="Hairline" Color="#E3E1DA"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TranscriptLog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TranscriptRowVm}">
                        <Border Padding="8,1" Margin="0,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRep}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAsk}" Value="True">
                                            <Setter Property="BorderBrush" Value="#B08A2E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAnswer}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3B6D11"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#3D3D3A">
                                <Run Text="{Binding Time, Mode=OneWay}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="{Binding Text, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding LiveLine}" FontStyle="Italic" FontSize="11"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LiveLine}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
