<Window x:Class="SalesSupport.Client.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesSupport.Client"
        Title="Transkript" Width="380" Height="560" MinWidth="280" MinHeight="240"
        Topmost="True" WindowStartupLocation="Manual"
        Background="{DynamicResource Theme.Ground}" Foreground="{DynamicResource Theme.Text}"
        FontFamily="{DynamicResource Theme.FontUi}" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Readout}" VerticalAlignment="Bottom" Margin="8,0,0,1" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding CompanyLine, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Duration, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="Transkript" FontSize="14" FontWeight="Medium"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding TranscriptLog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TranscriptRowVm}">
                        <Border Padding="8,2" Margin="0,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRep}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAsk}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAnswer}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Answer}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time, Mode=OneWay}" Style="{StaticResource Readout}" FontSize="10"
                                           Width="30" VerticalAlignment="Top" Margin="0,2,6,0"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Top"
                                           MinWidth="34" Margin="0,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRep}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAsk}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Warn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAnswer}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Answer}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAsk}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LiveLine}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding LiveLine}" Style="{StaticResource Readout}" FontStyle="Italic" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
