<Window x:Class="SalesSupport.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesSupport.Client"
        Title="SalesSupport" Width="384" Height="720" MinWidth="340"
        Topmost="True"
        Background="{DynamicResource Theme.Ground}" Foreground="{DynamicResource Theme.Text}"
        FontFamily="{DynamicResource Theme.FontUi}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Every color, font and radius comes from the active theme (D35); nothing visual is inline. -->
    <Grid Margin="14,12">

        <!-- ============ PRE-CALL ============ -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="PreCall">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Nytt samtal" Style="{StaticResource Title}" Margin="0,2,0,10"/>

            <!-- incoming call (D32) -->
            <Border Background="{DynamicResource Theme.AccentBg}" BorderBrush="{DynamicResource Theme.AccentBorder}" BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.CardRadius}" Padding="10,8" Margin="0,0,0,4" Effect="{DynamicResource Theme.FreshGlow}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IncomingBanner}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Phone}" Stroke="{DynamicResource Theme.Accent}"
                          Width="15" Height="15" Margin="0,2,9,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="{Binding IncomingBanner}" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding IncomingDetail}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Readout}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IncomingDetail}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="BACKEND" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Theme.FontMono}"/>

            <TextBlock Text="KÄLLA" Style="{StaticResource ZoneLabel}"/>
            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"/>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSource}" Value="Replay">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="MIKROFON (DU)" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name"/>
                <TextBlock Text="HÖGTALARE (KUNDEN, LOOPBACK)" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" DisplayMemberPath="Name"/>
            </StackPanel>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSource}" Value="Replay">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="SAMTAL ATT SPELA UPP" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding ReplaySamples}" SelectedItem="{Binding SelectedSample}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SPRÅK" Style="{StaticResource ZoneLabel}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TEMA" Style="{StaticResource ZoneLabel}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="KUND" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding CustomerCompany, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="MÅL MED SAMTALET" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="52" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

            <Button Content="Starta samtal" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,14,0,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock Text="TELAVOX-WEBHOOK (RINGING)" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding WebhookHint, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource Theme.FontMono}" FontSize="10"
                     Foreground="{DynamicResource Theme.TextDim}" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"/>
        </StackPanel>

        <!-- ============ LIVE ============ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="Live">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- status strip: live dot, clock, meters, timing readout, Logg / Avsluta -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Avsluta" Command="{Binding EndCommand}" Padding="9,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnding}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Logg" Style="{StaticResource QuietButton}" Click="ToggleTranscript" Padding="9,4" Margin="0,0,6,0"/>
                    <DockPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Theme.Answer}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                                            <Setter Property="Effect" Value="{DynamicResource Theme.DotGlow}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Duration}" Style="{StaticResource Readout}" Foreground="{DynamicResource Theme.Text}" Margin="0,0,10,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="MIC" Style="{StaticResource Readout}" FontSize="10" Margin="0,0,4,0"/>
                        <local:LevelMeter DockPanel.Dock="Left" Level="{Binding MicLevel}" OnBrush="{DynamicResource Theme.Accent}" OffBrush="{DynamicResource Theme.Border}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="SPK" Style="{StaticResource Readout}" FontSize="10" Margin="0,0,4,0"/>
                        <local:LevelMeter DockPanel.Dock="Left" Level="{Binding SpeakerLevel}" OnBrush="{DynamicResource Theme.Accent}" OffBrush="{DynamicResource Theme.Border}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LastTiming}" Style="{StaticResource Readout}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- notices -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding ErrorBanner}" Foreground="{DynamicResource Theme.Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorBanner}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding IncomingBanner}" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IncomingBanner}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding EndingNotice}" Foreground="{DynamicResource Theme.Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EndingNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel>
                    <!-- 01 questions -->
                    <TextBlock Text="01 · ATT FRÅGA" Style="{StaticResource ZoneLabel}" Margin="0,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding Questions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:QuestionVm}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fresh}" Value="True">
                                                    <Setter Property="Effect" Value="{DynamicResource Theme.FreshGlow}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBorder}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Asked}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Theme.Accent}"
                                              StrokeThickness="2.4" Margin="0,3,8,0" VerticalAlignment="Top"
                                              Visibility="{Binding Asked, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Asked}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextDim}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 02 products -->
                    <TextBlock Text="02 · FÖRESLÅ" Style="{StaticResource ZoneLabel}"/>
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProductVm}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fresh}" Value="True">
                                                    <Setter Property="Effect" Value="{DynamicResource Theme.FreshGlow}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBorder}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Style="{StaticResource Readout}" FontSize="10"
                                                       VerticalAlignment="Top" Margin="8,2,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Theme.FontMono}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Fresh}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 03 customer picture -->
                    <TextBlock Text="03 · KUNDBILD" Style="{StaticResource ZoneLabel}"/>
                    <TextBlock Text="{Binding CompanyLine}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Threads}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ThreadVm}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.AccentBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBorder}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Objection">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.WarnBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.WarnBorder}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Text="{Binding Label}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ActionItems}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Box}" Width="12" Height="12"
                                          StrokeThickness="1.8" Margin="0,3,7,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 04 the written half of the call: live partial, the ask thread (D34), the input -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock Text="{Binding LiveLine}" Style="{StaticResource Readout}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                <ScrollViewer x:Name="ChatScroller" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AskLog.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding AskLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AskItemVm}">
                                <StackPanel Margin="0,0,0,6">
                                    <Border Background="{DynamicResource Theme.AccentBg}" CornerRadius="{DynamicResource Theme.BubbleRadius}"
                                            Padding="8,5" HorizontalAlignment="Right" MaxWidth="300">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Query}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Query}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Theme.Accent}"/>
                                    </Border>
                                    <Border Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Theme.BubbleRadius}" Padding="8,5" HorizontalAlignment="Left" MaxWidth="320" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding AskCommand}" Width="36" Margin="6,0,0,0" Padding="0" Background="{DynamicResource Theme.Card}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Arrow}" Stroke="{DynamicResource Theme.Accent}" Width="15" Height="15"/>
                    </Button>
                    <Grid>
                        <TextBox Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" Padding="8,7">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Fråga assistenten…" Foreground="{DynamicResource Theme.TextDim}" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AskText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- ============ POST-CALL ============ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="PostCall">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,2,0,10">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Readout}" VerticalAlignment="Bottom" Margin="8,0,0,2">
                    <Run Text="{Binding Duration, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TranscriptLog.Count, Mode=OneWay}"/><Run Text=" repliker"/>
                </TextBlock>
                <TextBlock Text="Samtalet avslutat" Style="{StaticResource Title}"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="11,9">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Body}"/>
                    </Border>
                    <TextBlock Text="NÄSTA STEG" Style="{StaticResource ZoneLabel}"/>
                    <ItemsControl ItemsSource="{Binding NextSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="{StaticResource Icon.Box}" Width="12" Height="12"
                                          StrokeThickness="1.8" Margin="0,3,7,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AskLog.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="FRÅGOR UNDER SAMTALET" Style="{StaticResource ZoneLabel}"/>
                        <ItemsControl ItemsSource="{Binding AskLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AskItemVm}">
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Query}" FontWeight="Medium" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Accent}"/>
                                        <TextBlock Text="{Binding Answer}" Style="{StaticResource Body}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Nytt samtal" Style="{StaticResource PrimaryButton}" Command="{Binding NewCallCommand}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Transkript" Style="{StaticResource QuietButton}" Click="ToggleTranscript" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="Kopiera" Command="{Binding CopyCommand}" Padding="12,7"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
