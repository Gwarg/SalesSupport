<Window x:Class="SalesSupport.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesSupport.Client"
        Title="SalesSupport" Width="384" Height="720" MinWidth="340"
        Topmost="True" Background="#FAF9F5">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#185FA5"/>
        <SolidColorBrush x:Key="AccentBg" Color="#E6F1FB"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FAEEDA"/>
        <SolidColorBrush x:Key="WarnFg" Color="#854F0B"/>
        <SolidColorBrush x:Key="Muted" Color="#6B6A66"/>
        <SolidColorBrush x:Key="Hairline" Color="#E3E1DA"/>
        <Style x:Key="ZoneLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Background" Value="#F1EFE8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- ============ PRE-CALL ============ -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="PreCall">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Nytt samtal" FontSize="18" FontWeight="Medium" Margin="0,4,0,12"/>
            <Border Padding="10,8" CornerRadius="6" Margin="0,0,0,6" Background="{StaticResource AccentBg}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IncomingBanner}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding IncomingBanner}" Foreground="{StaticResource Accent}" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Backend" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding BackendUrl, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Källa" Style="{StaticResource ZoneLabel}"/>
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Width="120" HorizontalAlignment="Left"/>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSource}" Value="Replay">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Mikrofon (du)" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name"/>
                <TextBlock Text="Högtalare (kunden, loopback)" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" DisplayMemberPath="Name"/>
            </StackPanel>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSource}" Value="Replay">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Samtal att spela upp" Style="{StaticResource ZoneLabel}"/>
                <ComboBox ItemsSource="{Binding ReplaySamples}" SelectedItem="{Binding SelectedSample}"/>
            </StackPanel>
            <TextBlock Text="Språk" Style="{StaticResource ZoneLabel}"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="80" HorizontalAlignment="Left"/>
            <TextBlock Text="Kund (valfritt)" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding CustomerCompany, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Mål med samtalet (valfritt)" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/>
            <Button Content="Starta samtal" Command="{Binding StartCommand}" Margin="0,14,0,0" Padding="0,8"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" FontWeight="Medium"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="Inkommande samtal — klistra in som Telavox Personal Webhook (ringing)" Style="{StaticResource ZoneLabel}"/>
            <TextBox Text="{Binding WebhookHint, Mode=OneWay}" IsReadOnly="True" FontSize="10" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
        </StackPanel>

        <!-- ============ LIVE ============ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="Live">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- status strip -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Avsluta" Command="{Binding EndCommand}"
                        Padding="10,4" Background="Transparent" BorderBrush="#A32D2D" Foreground="#A32D2D">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnding}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="Logg" Click="ToggleTranscript" Padding="8,4" Margin="0,0,6,0"
                        Background="Transparent" BorderBrush="{StaticResource Hairline}" Foreground="{StaticResource Muted}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#3B6D11"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Duration}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,10,0"/>
                    <TextBlock Text="mic" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ProgressBar Width="38" Height="4" Margin="4,0,8,0" Maximum="100" Value="{Binding MicLevel, Mode=OneWay}"/>
                    <TextBlock Text="spk" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ProgressBar Width="38" Height="4" Margin="4,0,8,0" Maximum="100" Value="{Binding SpeakerLevel, Mode=OneWay}"/>
                    <TextBlock Text="{Binding LastTiming}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="{Binding ErrorBanner}" Foreground="#A32D2D" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorBanner}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding IncomingBanner}" Foreground="{StaticResource Accent}" FontWeight="Medium" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IncomingBanner}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding EndingNotice}" Foreground="{StaticResource Accent}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EndingNotice}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Att fråga" Style="{StaticResource ZoneLabel}"/>
                    <ItemsControl ItemsSource="{Binding Questions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:QuestionVm}">
                                <Border Style="{StaticResource Card}">
                                    <Border.Resources>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}"/>
                                    </Border.Resources>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Asked}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Fresh}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Föreslå" Style="{StaticResource ZoneLabel}"/>
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ProductVm}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fresh}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Why}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Price}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Kundbild" Style="{StaticResource ZoneLabel}"/>
                    <TextBlock Text="{Binding CompanyLine}" FontWeight="Medium" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Threads}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ThreadVm}">
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                                    <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Objection">
                                                    <Setter Property="Background" Value="{StaticResource WarnBg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" Text="{Binding Label}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#3D3D3A" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ActionItems}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,1">
                                    <Run Text="☐ "/><Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ask lane -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <TextBlock Text="{Binding LiveLine}" FontSize="11" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Background" Value="#F5F4EF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnswerText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding AnswerText}" TextWrapping="Wrap" FontSize="12"/>
                </Border>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="➤" Command="{Binding AskCommand}" Width="36" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" Padding="6,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AskCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- ============ POST-CALL ============ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Stage}" Value="PostCall">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Samtalet avslutat" FontSize="18" FontWeight="Medium" Margin="0,4,0,10"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap"/>
                    <TextBlock Text="Nästa steg" Style="{StaticResource ZoneLabel}"/>
                    <ItemsControl ItemsSource="{Binding NextSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="☐ "/><Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Transkript" Click="ToggleTranscript" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="Kopiera" Command="{Binding CopyCommand}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="Nytt samtal" Command="{Binding NewCallCommand}" Padding="14,6"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
